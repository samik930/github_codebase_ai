# Google Gemini API Key
GOOGLE_API_KEY=

# Qdrant Vector Database
QDRANT_URL=
QDRANT_API_KEY=

# GitHub API Token
GITHUB_TOKEN=

# MongoDB Connection
MONGODB_URI=

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Redis & BullMQ Configuration
# For Upstash: rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Ingestion Queue Name
INGESTION_QUEUE_NAME=repository-ingestion

# Concurrency per worker instance (default: 2)
INGESTION_WORKER_CONCURRENCY=2

# Internal Service URLs & Secrets
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_SECRET=

