# ===================================================
# Codebase Copilot - Environment Configuration
# ===================================================

# Google Gemini API Key (Embeddings & Answering)
GOOGLE_API_KEY=

# Qdrant Vector Database
QDRANT_URL=
QDRANT_API_KEY=

# GitHub API Token (For downloading repository code & assets)
GITHUB_TOKEN=

# MongoDB Database URI (Persistent Multi-User Metadata, Jobs, and Chats)
MONGODB_URI=

# Google OAuth Client ID (For Multi-User Authentication)
GOOGLE_CLIENT_ID=

# ===================================================
# Redis & BullMQ Queue Configuration
# ===================================================
# For Upstash: paste your connection string below:
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Ingestion Queue Name
INGESTION_QUEUE_NAME=repository-ingestion

# Concurrency per worker instance (default: 2)
INGESTION_WORKER_CONCURRENCY=2

# Internal Service URLs & Secrets
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_SECRET=

